import speech_recognition as sr # Automatic speech recognition

# Create a Recognizer object
r = sr.Recognizer()

# Use the default microphone as the audio source
with sr.Microphone() as source: # Accessing the microphone
    print("Speak:")
   
    # Adjust for ambient noise levels to improve accuracy
    r.adjust_for_ambient_noise(source, duration=1) 
    
    audio = r.listen(source) # Captures audio from microphone
    print("Audio captured. Processing...")

try:
    # Convert speech to text using the Google Web Speech API
    text = r.recognize_google(audio, language="en-US") # Sends the audio to Google Web Speech API
    print(f"Recognized text is: {text}")

except sr.UnknownValueError:
    # This exception is raised when the speech is unintelligible
    print("Speech recognition could not understand the audio.")

except sr.RequestError as e:
    # This exception is raised if there are issues with the API request, No internet issues
    print(f"Could not request results from Google Speech Recognition service; {e}")
